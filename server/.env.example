# Server Environment Variables Template for Production (Render) & Development
PORT=4500
NODE_ENV=production

# MongoDB Atlas Database Connection String (Replace with your Atlas URI)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/AYUSH_WEBSITE?retryWrites=true&w=majority

# JWT Authentication Secret & Token Expiration
JWT_SECRET=ayush_rider_portal_jwt_secret_key_2026_secure
JWT_EXPIRES_IN=1d

# Default Initial Super Admin Credentials (Created automatically on first start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Frontend Client URL (Deployed Vercel domain or localhost)
CLIENT_URL=https://your-frontend-app.vercel.app

# SMTP / Email Configuration for automated report emails (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Ayush Hub Management" <your_email@gmail.com>